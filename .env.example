# Supabase credentials
# Copy this file to .env.local and fill in your credentials
#
# For LOCAL DEVELOPMENT, use dev Supabase project:
VITE_SUPABASE_URL=https://fox-ricciardi-dev.supabase.co
VITE_SUPABASE_ANON_KEY=dev-anon-key-here

# For PRODUCTION, use prod Supabase project:
# VITE_SUPABASE_URL=https://[PROD-PROJECT-REF].supabase.co
# VITE_SUPABASE_ANON_KEY=[PROD-ANON-KEY]

# Server-only — used by Vercel API functions. Never prefix with VITE_ (would expose to browser).
# Get from: Supabase dashboard → Project Settings → API → service_role key
# Set in Vercel dashboard per environment (dev = dev service role, prod = prod service role)
SUPABASE_SERVICE_ROLE_KEY=[SERVICE-ROLE-KEY]
